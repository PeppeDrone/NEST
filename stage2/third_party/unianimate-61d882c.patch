+
+def safe_ratio(num, den, default=1.0, eps=1e-6):
+    if not np.isfinite(num) or not np.isfinite(den) or abs(float(den)) < eps:
+        return default
+    return num / den
+
+
+def _log_debug(message, logger=None):
+    if logger is not None:
+        logger.warning(message)
+    else:
+        print(message)
+
+
+def debug_body_candidate(tag, result, logger=None):
+    bodies = result.get('bodies', {}) if isinstance(result, dict) else {}
+    candidate = np.asarray(bodies.get('candidate', np.array([])))
+    subset = np.asarray(bodies.get('subset', np.array([])))
+
+    _log_debug(f"[pose-debug:{tag}] candidate shape: {candidate.shape}", logger)
+    if candidate.size == 0:
+        _log_debug(f"[pose-debug:{tag}] candidate is empty", logger)
+    else:
+        xy = candidate[..., :2]
+        finite_xy = np.isfinite(xy)
+        finite_joint_mask = np.all(finite_xy, axis=-1)
+        bad_joint_indices = np.argwhere(~finite_joint_mask)
+        _log_debug(f"[pose-debug:{tag}] finite XY joints: {int(finite_joint_mask.sum())}/{finite_joint_mask.size}", logger)
+        _log_debug(f"[pose-debug:{tag}] NaN/Inf joint indices: {bad_joint_indices.tolist()}", logger)
+        for joint_idx in range(min(candidate.shape[0], len(OPENPOSE_BODY_JOINT_NAMES))):
+            x_finite = bool(np.isfinite(candidate[joint_idx, 0]))
+            y_finite = bool(np.isfinite(candidate[joint_idx, 1]))
+            _log_debug(
+                f"[pose-debug:{tag}] joint {joint_idx:02d} {OPENPOSE_BODY_JOINT_NAMES[joint_idx]}: "
+                f"x_finite={x_finite} y_finite={y_finite} value={candidate[joint_idx, :2].tolist()}",
+                logger,
+            )
+
+    _log_debug(f"[pose-debug:{tag}] subset shape: {subset.shape}", logger)
+    _log_debug(f"[pose-debug:{tag}] subset values: {subset.tolist() if subset.size else []}", logger)
+
+
+def pose_has_invalid_coordinates(result):
+    bodies = result.get('bodies', {}) if isinstance(result, dict) else {}
+    candidate = np.asarray(bodies.get('candidate', np.array([])))
+    if candidate.size == 0:
+        return True
+    return not np.all(np.isfinite(candidate[..., :2]))
+
+
+def validate_pose_before_draw(tag, result, args, logger):
+    if args.debug_pose_failures:
+        debug_body_candidate(tag, result, logger=logger)
+    if pose_has_invalid_coordinates(result):
+        debug_body_candidate(tag, result, logger=logger)
+        message = f"Invalid NaN/Inf pose coordinates before draw_pose at {tag}"
+        if args.skip_invalid_pose_frames:
+            logger.warning("%s; skipping frame because --skip_invalid_pose_frames is set", message)
+            return False
+        raise RuntimeError(message)
+    return True
+
+
+def _valid_xy_mask(points):
+    points = np.asarray(points)
+    return np.isfinite(points[..., :2]).all(axis=-1) & (points[..., 0] >= 0) & (points[..., 1] >= 0)
+
+
+def _interpolate_short_gaps(series, valid, max_gap):
+    """Interpolate short invalid runs in a [T, 2] coordinate series."""
+    out = series.copy()
+    valid = valid.copy()
+    total_frames = out.shape[0]
+    frame_idx = 0
+    while frame_idx < total_frames:
+        if valid[frame_idx]:
+            frame_idx += 1
+            continue
+
+        start = frame_idx
+        while frame_idx < total_frames and not valid[frame_idx]:
+            frame_idx += 1
+        end = frame_idx - 1
+        gap_len = end - start + 1
+        if gap_len > max_gap:
+            continue
+
+        left = start - 1 if start - 1 >= 0 and valid[start - 1] else None
+        right = frame_idx if frame_idx < total_frames and valid[frame_idx] else None
+        if left is None and right is None:
+            continue
+        if left is not None and right is not None:
+            xs = [left, right]
+            target = np.arange(start, end + 1)
+            for coord_idx in range(2):
+                out[start : end + 1, coord_idx] = np.interp(
+                    target,
+                    xs,
+                    [out[left, coord_idx], out[right, coord_idx]],
+                )
+        elif left is not None:
+            out[start : end + 1] = out[left]
+        elif right is not None:
+            out[start : end + 1] = out[right]
+        valid[start : end + 1] = True
+    return out, valid
+
+
+def _smooth_1d(values, window, poly):
+    if len(values) < 3:
+        return values
+    window = int(window)
+    poly = int(poly)
+    if window % 2 == 0:
+        window += 1
+    window = min(window, len(values) if len(values) % 2 == 1 else len(values) - 1)
+    if window < 3 or window <= poly:
+        return values
+    try:
+        from scipy.signal import savgol_filter
+
+        return savgol_filter(values, window_length=window, polyorder=poly, mode="interp")
+    except Exception:
+        pad = window // 2
+        padded = np.pad(values, (pad, pad), mode="edge")
+        kernel = np.ones((window,), dtype=np.float32) / float(window)
+        return np.convolve(padded, kernel, mode="valid")
+
+
+def _reject_temporal_outliers(series, valid, threshold=0.12, local_window=2):
+    """Mark isolated spatial jumps invalid before interpolation/smoothing."""
+    threshold = float(threshold or 0.0)
+    local_window = int(local_window)
+    if threshold <= 0 or local_window <= 0 or int(valid.sum()) < 3:
+        return series, valid, 0
+
+    out = series.copy()
+    out_valid = valid.copy()
+    rejected = np.zeros((out.shape[0],), dtype=bool)
+
+    for frame_idx in range(out.shape[0]):
+        if not out_valid[frame_idx]:
+            continue
+
+        start = max(0, frame_idx - local_window)
+        end = min(out.shape[0], frame_idx + local_window + 1)
+        neighbor_mask = out_valid[start:end].copy()
+        neighbor_mask[frame_idx - start] = False
+        if int(neighbor_mask.sum()) < 2:
+            continue
+
+        neighbors = out[start:end][neighbor_mask]
+        if not np.isfinite(neighbors).all():
+            continue
+
+        local_median = np.median(neighbors, axis=0)
+        residual = float(np.linalg.norm(out[frame_idx] - local_median))
+        if residual <= threshold:
+            continue
+
+        prev_candidates = np.flatnonzero(out_valid[start:frame_idx]) + start
+        next_candidates = np.flatnonzero(out_valid[frame_idx + 1 : end]) + frame_idx + 1
+        has_prev = len(prev_candidates) > 0
+        has_next = len(next_candidates) > 0
+
+        if has_prev and has_next:
+            prev_idx = int(prev_candidates[-1])
+            next_idx = int(next_candidates[0])
+            alpha = (frame_idx - prev_idx) / float(max(next_idx - prev_idx, 1))
+            expected = (1.0 - alpha) * out[prev_idx] + alpha * out[next_idx]
+            interp_residual = float(np.linalg.norm(out[frame_idx] - expected))
+            jump_from_prev = float(np.linalg.norm(out[frame_idx] - out[prev_idx]))
+            jump_to_next = float(np.linalg.norm(out[frame_idx] - out[next_idx]))
+            bridge_motion = float(np.linalg.norm(out[next_idx] - out[prev_idx]))
+            if (
+                interp_residual > threshold
+                and jump_from_prev > threshold
+                and jump_to_next > threshold
+                and bridge_motion <= threshold * 1.5
+            ):
+                rejected[frame_idx] = True
+        elif residual > threshold * 1.5 and int(neighbor_mask.sum()) >= 3:
+            # Endpoint spikes are less certain, so require a stronger residual.
+            rejected[frame_idx] = True
+
+    if rejected.any():
+        out[rejected] = np.nan
+        out_valid[rejected] = False
+
+    return out, out_valid, int(rejected.sum())
+

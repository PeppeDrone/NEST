+def _smooth_coordinate_array(
+    points,
+    max_gap=4,
+    window=5,
+    poly=2,
+    outlier_thresh=0.12,
+    outlier_window=2,
+):
+    """Reject spikes, interpolate short gaps, and smooth an array shaped [T, ..., 2]."""
+    points = np.asarray(points, dtype=np.float32)
+    original_shape = points.shape
+    if points.ndim < 3 or original_shape[-1] != 2 or original_shape[0] < 2:
+        valid = _valid_xy_mask(points)
+        return points.copy(), valid, 0
+
+    flat = points.reshape(original_shape[0], -1, 2).copy()
+    valid = _valid_xy_mask(flat)
+    flat[~valid] = np.nan
+    rejected_total = 0
+
+    for joint_idx in range(flat.shape[1]):
+        series = flat[:, joint_idx, :]
+        joint_valid = valid[:, joint_idx]
+        if not joint_valid.any():
+            continue
+
+        series, joint_valid, rejected_count = _reject_temporal_outliers(
+            series,
+            joint_valid,
+            threshold=outlier_thresh,
+            local_window=outlier_window,
+        )
+        rejected_total += rejected_count
+        series, joint_valid = _interpolate_short_gaps(series, joint_valid, int(max_gap))
+        valid[:, joint_idx] = joint_valid
+
+        frame_idx = 0
+        while frame_idx < flat.shape[0]:
+            if not joint_valid[frame_idx]:
+                frame_idx += 1
+                continue
+            start = frame_idx
+            while frame_idx < flat.shape[0] and joint_valid[frame_idx]:
+                frame_idx += 1
+            end = frame_idx
+            if end - start >= 3:
+                for coord_idx in range(2):
+                    series[start:end, coord_idx] = _smooth_1d(series[start:end, coord_idx], window, poly)
+        flat[:, joint_idx, :] = series
+
+    flat[~valid] = -1.0
+    return flat.reshape(original_shape), valid.reshape(original_shape[:-1]), rejected_total
+
+
+def smooth_pose_sequence(
+    results_vis,
+    max_gap=4,
+    window=5,
+    poly=2,
+    outlier_thresh=0.12,
+    hand_outlier_thresh=0.08,
+    outlier_window=2,
+    logger=None,
+):
+    """Smooth aligned DWPose coordinates before rendering pose maps."""
+    if len(results_vis) < 2:
+        return copy.deepcopy(results_vis)
+
+    smoothed = copy.deepcopy(results_vis)
+
+    body = np.stack([pose["bodies"]["candidate"] for pose in smoothed], axis=0)
+    body_smooth, body_valid, body_rejected = _smooth_coordinate_array(
+        body,
+        max_gap=max_gap,
+        window=window,
+        poly=poly,
+        outlier_thresh=outlier_thresh,
+        outlier_window=outlier_window,
+    )
+    for frame_idx, pose in enumerate(smoothed):
+        pose["bodies"]["candidate"] = body_smooth[frame_idx]
+        subset = np.asarray(pose["bodies"]["subset"]).copy()
+        if subset.ndim == 1:
+            subset = subset[np.newaxis, :]
+        for joint_idx in range(min(subset.shape[-1], body_valid.shape[1])):
+            subset[0, joint_idx] = float(joint_idx) if body_valid[frame_idx, joint_idx] else -1.0
+        pose["bodies"]["subset"] = subset
+
+    faces = np.stack([pose["faces"] for pose in smoothed], axis=0)
+    faces_smooth, _, face_rejected = _smooth_coordinate_array(
+        faces,
+        max_gap=max_gap,
+        window=window,
+        poly=poly,
+        outlier_thresh=outlier_thresh,
+        outlier_window=outlier_window,
+    )
+    for frame_idx, pose in enumerate(smoothed):
+        pose["faces"] = faces_smooth[frame_idx]
+
+    hands = np.stack([pose["hands"] for pose in smoothed], axis=0)
+    hands_smooth, _, hand_rejected = _smooth_coordinate_array(
+        hands,
+        max_gap=max_gap,
+        window=window,
+        poly=poly,
+        outlier_thresh=hand_outlier_thresh,
+        outlier_window=outlier_window,
+    )
+    for frame_idx, pose in enumerate(smoothed):
+        pose["hands"] = hands_smooth[frame_idx]
+
+    if logger is not None:
+        logger.info(
+            "Smooth pose outlier rejection marked invalid: body=%s face=%s hands=%s",
+            body_rejected,
+            face_rejected,
+            hand_rejected,
+        )
+
+    return smoothed
+
+
+def save_pose_sequence(results_vis, save_dir, args, logger):
+    os.makedirs(save_dir, exist_ok=True)
+    saved = 0
+    for i in range(len(results_vis)):
+        if not validate_pose_before_draw(f"{save_dir}/frame_{i:04d}_before_draw", results_vis[i], args, logger):
+            continue
+        dwpose_woface, _ = draw_pose(results_vis[i], H=768, W=512)
+        img_path = save_dir + "/" + str(i).zfill(4) + ".jpg"
+        cv2.imwrite(img_path, dwpose_woface)
+        saved += 1
+    return saved
+
+
+def save_reference_pose(pose_ref, save_dir, args, logger):
+    if not validate_pose_before_draw(f"{save_dir}/reference_pose_final_draw", pose_ref, args, logger):
+        logger.warning("Skipping final reference pose draw because reference pose is invalid.")
+        return False
+    dwpose_woface, _ = draw_pose(pose_ref, H=768, W=512)
+    img_path = save_dir + "/" + "pose.jpg"
+    cv2.imwrite(img_path, dwpose_woface)
+    return True
